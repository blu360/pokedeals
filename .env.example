# Copy to .env (never commit it) and fill in. Get the keys at https://developer.ebay.com/my/keys
# using the PRODUCTION keyset: App ID is the client id, Cert ID is the client secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: your 5-digit US ZIP, so eBay can price calculated shipping
EBAY_BUYER_ZIP=
